<article class="article-view post-full">
    <h1 class="article-title">
        <%= page.title %>
    </h1>

    <div class="article-meta">
        <span title="<%= date(page.date, 'YYYY-MM-DD HH:mm') %>"><%= date(page.date, 'YYYY-MM-DD') %></span>
        <% if (page.tags && page.tags.length) { %>
            <span class="meta-sep">·</span>
            <%- list_tags(page.tags, { show_count: false, style: 'none', separator: ', ' }) %>
        <% } %>
    </div>

    <div class="article-content post-content">
        <%- page.content %>
    </div>
</article>

<% if (page.prev || page.next) { %>
<nav class="post-nav">
    <% if (page.prev) { %>
        <a class="post-nav-item post-nav-prev" href="<%- url_for(page.prev.path) %>" rel="prev">
            <span class="post-nav-dir"><span class="post-nav-arrow">‹</span> 上一篇</span>
            <span class="post-nav-title"><%= page.prev.title %></span>
        </a>
    <% } else { %>
        <span class="post-nav-item is-empty"></span>
    <% } %>
    <% if (page.next) { %>
        <a class="post-nav-item post-nav-next" href="<%- url_for(page.next.path) %>" rel="next">
            <span class="post-nav-dir">下一篇 <span class="post-nav-arrow">›</span></span>
            <span class="post-nav-title"><%= page.next.title %></span>
        </a>
    <% } else { %>
        <span class="post-nav-item is-empty"></span>
    <% } %>
</nav>
<% } %>

<!-- 👇 这里开始是 Waline 的大门 👇 -->
<section class="post-comments" style="margin-top: 40px; margin-bottom: 40px;">
    <h2 class="post-comments-title" style="font-size: 1.2em; margin-bottom: 15px;">评论</h2>
    <!-- 引入 Waline 的样式 -->
    <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
    
    <!-- Waline 的挂载点 -->
    <div id="waline"></div>
    
    <!-- Waline 的初始化脚本 -->
    <script type="module">
      import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';
      init({
        el: '#waline',
        // ⚠️ 注意：下面这个链接，一定要换成你刚才在 Vercel 复制的那个真实链接！！！
        serverURL: 'my-waline-beige.vercel.app', 
        lang: 'zh-CN',
        meta: ['nick', 'mail', 'link'], // 让路人填昵称、邮箱、网址
        requiredMeta: ['nick', 'mail'], // 昵称和邮箱为必填项
        login: 'disable', // 强制关闭登录，完全匿名评论
        dark: 'html[data-theme="dark"]' // 自动适配暗色模式
      });
    </script>
</section>