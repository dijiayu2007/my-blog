<div class="win7-tag-wall" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 15px; padding: 20px 10px;">
    <% if (site.tags.length) { %>
        <% site.tags.sort('name').each(function(tag) { %>
            <!-- 👇 这里的样式完美复刻了你的头像框和日历的毛玻璃质感 👇 -->
            <a href="<%- url_for(tag.path) %>" class="win7-tag-item" style="
                display: flex; 
                flex-direction: column; 
                align-items: center; 
                justify-content: center;
                padding: 15px 10px; 
                background: rgba(255, 255, 255, 0.45); 
                backdrop-filter: blur(12px); 
                -webkit-backdrop-filter: blur(12px); 
                border: 1px solid rgba(255, 255, 255, 0.7); 
                border-radius: 8px; 
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08); 
                text-decoration: none; 
                transition: all 0.3s ease;
                color: #333;
            "
            onmouseover="this.style.background='rgba(255, 255, 255, 0.8)'; this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 20px rgba(0, 0, 0, 0.15)';"
            onmouseout="this.style.background='rgba(255, 255, 255, 0.45)'; this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0, 0, 0, 0.08)';"
            >
                <!-- 标签名字 -->
                <span style="font-size: 16px; font-weight: bold; color: #3c7fb1; margin-bottom: 5px;">
                    <%= tag.name %>
                </span>
                <!-- 标签里的文章数量 -->
                <span style="font-size: 12px; background: rgba(60, 127, 177, 0.15); color: #3c7fb1; padding: 2px 8px; border-radius: 10px;">
                    <%= tag.length %> 篇
                </span>
            </a>
        <% }); %>
    <% } else { %>
        <p style="color: #666;">暂无标签</p>
    <% } %>
</div>